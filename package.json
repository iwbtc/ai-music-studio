{
  "name": "dsh-ai-music-studio",
  "version": "2.4.0",
  "description": "AI 音乐工作室：Windows 桌面 DAW（Electron + Web Audio），同时是 DeepSeek Harness 插件，支持 AI 工具编曲、VST3 外部插件与导出。",
  "type": "module",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "standalone/",
    "assets/",
    "cordis.patch.yml",
    "README.md",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:exe": "node desktop/build-exe.mjs",
    "test": "node --test test/*.test.mjs",
    "install-plugin": "node scripts/install.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iwbtc/ai-music-studio.git"
  },
  "homepage": "https://github.com/iwbtc/ai-music-studio#readme",
  "bugs": {
    "url": "https://github.com/iwbtc/ai-music-studio/issues"
  },
  "keywords": [
    "daw",
    "music",
    "electron",
    "web-audio",
    "vst3",
    "ai",
    "deepseek-harness",
    "windows"
  ],
  "devDependencies": {
    "esbuild": "^0.25.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "lamejs": "^1.2.1",
    "libflacjs": "^5.6.0",
    "nvst3-host": "0.3.1"
  }
}
